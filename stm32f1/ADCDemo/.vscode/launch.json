{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "./build/Debug/ADCDemo.elf",
            "request": "launch",
            "gdbPath": "arm-none-eabi-gdb",
            "servertype": "openocd",
            "serverpath": "openocd",
            "device": "STM32F103C6",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "interface": "swd",
            "preLaunchTask": "Cmake:build",
        }
    ]
}