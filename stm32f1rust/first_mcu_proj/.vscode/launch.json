{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "target/thumbv7m-none-eabi/debug/first_mcu_proj",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "runToEntryPoint": "main",
            "interface": "swd",
            "svdFile": "STM32F103.svd",
            "preLaunchTask": "rust: cargo build[MCU]"
        }
    ]
}