{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "./build/MyStm32F407Project.elf",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "openocd",
            "device": "STM32F407VG",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "interface": "swd",
            "preLaunchTask": "Cmake:build",
            "svdFile": "./Drivers/CMSIS/Start_Linker_SVD/STM32F407.svd"
        }
    ]
}